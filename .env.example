# .env.example  —  copy to .env and fill in your values

# Deployment profile 
# "local"  → QDRANT_LAPTOP profile (all-RAM, no quant, HNSW m=16)
# "hpc"    → QDRANT_HPC profile   (mmap, scalar quant, HNSW m=32)
INDEXING_PROFILE=local

# Qdrant
# Local Docker (default) — leave QDRANT_URL and QDRANT_API_KEY empty.
# Cloud Qdrant           — set both values below.
QDRANT_URL=
QDRANT_API_KEY=

# HuggingFace 
# Required to download gated models (Gemma, Qwen3, Jina v3).
HF_TOKEN=

# Optional : redirect all HF downloads to a shared cache (useful on HPC).
HF_HOME=/scratch/your_user/.cache/huggingface

# Optional : API key for remote embedding services
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_BASE=

# Optional : LangSmith tracing configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="project_name"