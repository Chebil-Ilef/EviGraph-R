# .env.example  —  copy to .env and fill in your values

# Deployment profile 
# "local"  → QDRANT_LAPTOP profile (all-RAM, no quant, HNSW m=16)
# "hpc"    → QDRANT_HPC profile   (mmap, scalar quant, HNSW m=32)
INDEXING_PROFILE=local

# HPC Singularity configuration (required for --profile hpc)
SINGULARITY_CACHEDIR=/tmp/singularity_cache
SINGULARITY_TMPDIR=/tmp/singularity_tmp

# Path to the Qdrant Singularity image (.sif).
# Stored in $HOME so it persists across workspace expirations.
# The eval script will auto-build it if missing (requires internet access).
QDRANT_SIF_PATH=/home/ilch217i/qdrant.sif

# Qdrant
# Local Docker (default) — leave QDRANT_URL and QDRANT_API_KEY empty.
# Cloud Qdrant           — set both values below.
QDRANT_URL=
QDRANT_API_KEY=

# HuggingFace 
# Required to download gated models (Gemma, Qwen3, Jina v3).
HF_TOKEN=

# LLM API keys (e.g. OpenAI, Azure, Gemma, Qwen3, etc.) REQUIRED
LLM_API_KEY=
LLM_API_BASE=

# Optional: You can also set it in config/settings.py
# Example openai/gpt-4o-mini or ollama/model_name or openai/meta-llama/Llama-3.3-70B-Instruct if self hosted and openai compatible.
LLM_MODEL=

# Optional but recommended : redirect all HF downloads to a shared cache (useful on HPC).
HF_HOME=

# Optional : LangSmith tracing configuration
LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=